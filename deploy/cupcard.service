[Unit]
Description=CupCard MAX loyalty bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cupcard
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/cupcard/.env
ExecStart=/opt/cupcard/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
