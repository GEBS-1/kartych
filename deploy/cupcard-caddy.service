[Unit]
Description=Caddy HTTPS for CupCard
After=network-online.target cupcard.service
Wants=network-online.target

[Service]
Type=simple
Environment=PUBLIC_HOST=195.19.7.201.sslip.io
ExecStart=/usr/local/bin/caddy run --config /opt/cupcard/deploy/Caddyfile.vps --adapter caddyfile
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
