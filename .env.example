# --- MAX ---
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_API_BASE=https://platform-api2.max.ru

# Публичный HTTPS-домен без завершающего слэша.
# Пример: https://cupcard.example.ru
PUBLIC_BASE_URL=https://your-domain.ru
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=ChangeMeWebhookSecret1

# --- приложение ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- инфраструктура ---
DATABASE_URL=postgresql+asyncpg://cupcard:cupcard@localhost:5432/cupcard
REDIS_URL=redis://localhost:6379/0

# --- сторож подписки ---
WATCHDOG_INTERVAL_SECONDS=60
SUBSCRIBE_ON_STARTUP=true
UPDATE_TYPES=bot_started,message_created,message_callback,bot_stopped

# --- VPS / HTTPS (для docker-compose.prod) ---
# Домен, на который смотрит Caddy и выпускает сертификат Let's Encrypt.
PUBLIC_HOST=your-domain.ru
LETSENCRYPT_EMAIL=you@example.com

VPS_HOST=
VPS_USER=root
VPS_PASSWORD=
VPS_PORT=22
